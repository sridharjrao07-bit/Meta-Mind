# ─────────────────────────────────────────────────────────────
# MetaMind Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file (it is listed in .gitignore).
# ─────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────
# Found in: Supabase project → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# Service role key bypasses RLS — backend only, never sent to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# JWT secret — required even for ES256/RS256 projects (must fail startup if unset)
# Found in: Supabase project → Settings → API → JWT Settings
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ── Debate Agent + Planner (Groq) ─────────────────────────────
# Generate at: https://console.groq.com
GROQ_API_KEY=your-groq-key-here
# Model used for the Debate Agent generation + scoring calls
# Default: llama-3.3-70b-versatile
GROQ_DEBATE_MODEL=llama-3.3-70b-versatile
# Model used for planner, fact-check, compression helpers (fast, cheap)
# Options: llama-3.1-8b-instant | llama-3.3-70b-versatile
GROQ_MODEL=llama-3.1-8b-instant

# ── Embeddings (Phase 5 — leave empty for Phase 1/2) ──────────
# Generate at: https://platform.openai.com
OPENAI_API_KEY=

# ── App Settings ──────────────────────────────────────────────
# Frontend origin for CORS — change to real domain in production
FRONTEND_ORIGIN=http://localhost:5173
# Secret for any backend-signed tokens (generate a long random string)
APP_SECRET_KEY=change-me-to-a-long-random-secret

# ── Environment ───────────────────────────────────────────────
ENVIRONMENT=development
